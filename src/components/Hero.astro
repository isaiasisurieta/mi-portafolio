---
const keyRows = [
	{ keys: 13, size: 'sm' },
	{ keys: 14, size: 'sm' },
	{ keys: 13, size: 'sm' },
	{ keys: 12, size: 'sm' },
	{ keys: 11, size: 'md' },
];
---

<section
	id="inicio"
	class="mx-auto flex max-w-6xl flex-col items-center px-4 py-12 sm:py-20"
>
	<div class="laptop-scene w-full max-w-3xl">
		<div class="laptop group relative">
			<div
				class="laptop-lid relative overflow-hidden rounded-t-[1.4rem] border border-b-0 border-black/70 bg-linear-to-br from-[#252b36] via-[#151a22] to-[#0d1016] shadow-[0_-20px_55px_-28px_rgba(0,0,0,0.85),0_26px_52px_-28px_rgba(0,0,0,0.95),inset_0_1px_0_rgba(255,255,255,0.06)]"
			>
				<div class="flex h-5 items-center justify-center sm:h-6">
					<div
						class="relative h-1.5 w-1.5 rounded-full bg-[#0d1015] ring-1 ring-white/15"
						aria-hidden="true"
					>
						<span class="absolute inset-0.75 rounded-full bg-sky-300/70 shadow-[0_0_6px_rgba(125,211,252,0.6)]"></span>
					</div>
				</div>

				<div class="px-2 pb-2 sm:px-3 sm:pb-3">
					<div
						class="relative aspect-video overflow-hidden rounded-[0.7rem] border border-black/90 bg-[#0d1117] shadow-[inset_0_0_0_2px_rgba(0,0,0,0.45),inset_0_0_32px_rgba(0,0,0,0.6),0_2px_5px_rgba(0,0,0,0.55)]"
						data-laptop-screen
					>
						<h1 class="sr-only">Isaías — Software Engineer</h1>

						<video
							class="screen-video absolute inset-0 z-10 h-full w-full object-cover"
							data-intro-video
							data-video-src="/video_hack.mp4"
							muted
							playsinline
							preload="none"
							aria-hidden="true"
						></video>

							<div class="screen-reflection pointer-events-none absolute inset-0 z-30" aria-hidden="true"></div>

						<div
							class="screen-terminal absolute inset-0 z-20 flex h-full flex-col bg-[#0f131a]/[.98] font-mono text-xs leading-relaxed text-[#abb2bf] opacity-0 sm:text-sm"
							data-intro-terminal
							aria-hidden="true"
						>
							<div class="terminal-topbar relative z-10 flex items-center gap-1.5 border-b border-white/10 bg-[#171b22] px-3 py-2 sm:px-4">
									<span class="h-2 w-2 rounded-full bg-[#e06c75]"></span>
									<span class="h-2 w-2 rounded-full bg-[#e5c07b]"></span>
									<span class="h-2 w-2 rounded-full bg-[#98c379]"></span>
									<span class="ml-2 text-[10px] tracking-wide text-[#5c6370] sm:text-xs">isaías@portfolio — zsh</span>
								</div>
								<div class="screen-scanlines pointer-events-none absolute inset-0"></div>
							<div class="relative z-10 min-h-0 flex-1 overflow-hidden p-3 text-[11px] leading-snug sm:p-4 sm:text-xs">
								{/* Primer Prompt: whoami */}
								<div class="flex flex-wrap items-baseline gap-x-2">
									<span class="text-green-400">isaías@portfolio</span>
									<span class="text-zinc-500">:</span>
									<span class="text-green-200">~</span>
									<span class="text-zinc-100">$</span>
									<span data-typed-command1></span><span class="typed-cursor" aria-hidden="true" data-terminal-cursor="1"></span>
								</div>

								{/* Foto, Nombre, Título e Info */}
								<div class="mt-4 hidden flex-col gap-3" data-typed-profile>
									<div class="flex items-center gap-4">
										<img
											src="/foto_p2.png"
											alt="Isaías"
											class="h-20 w-20 rounded-full border-2 border-green-500/50 object-cover shadow-md sm:h-24 sm:w-24"
										/>
										<div class="space-y-1">
											<p class="text-sm font-bold text-zinc-100 sm:text-lg">
												<span class="text-zinc-500 font-normal text-xs sm:text-sm">name  : </span>Isaías Isurieta
											</p>
											<p class="text-sm font-bold text-green-400 sm:text-lg">
												<span class="text-zinc-500 font-normal text-xs sm:text-sm">title : </span>Software Engineer
											</p>
										</div>
									</div>
									<p class="max-w-2xl text-xs leading-relaxed text-zinc-300 sm:text-sm">
										Tengo 6 meses de experiencia en el sector de desarrollo de software, me gusta programar tanto webs como aplicaciones de escritorio, Viva linux!
									</p>
								</div>

								{/* Segundo Prompt: cat contact.txt */}
								<div class="mt-4 hidden flex-wrap items-baseline gap-x-2" data-typed-prompt2>
									<span class="text-green-400">isaías@portfolio</span>
									<span class="text-zinc-500">:</span>
									<span class="text-green-200">~</span>
									<span class="text-zinc-100">$</span>
									<span data-typed-command2></span><span class="typed-cursor" aria-hidden="true" data-terminal-cursor="2"></span>
								</div>

								{/* Enlaces de Contacto */}
								<div
									class="mt-2 hidden space-y-1 text-xs text-zinc-300 sm:text-sm"
									data-typed-links>
									<p>
										<span class="text-green-500">email</span>
										<span class="text-zinc-600">:</span>
										<a
											class="text-zinc-100 underline decoration-green-700 underline-offset-2 hover:text-green-300"
											href="mailto:isaiasisurieta@gmail.com"
										>isaiasisurieta@gmail.com</a>
										<button
											type="button"
											class="ml-2 text-zinc-100 underline decoration-green-700 underline-offset-2 hover:text-green-300 cursor-pointer"
											data-copy-email="isaiasisurieta@gmail.com"
										>Copiar</button>
										<span data-copy-feedback role="status" aria-live="polite"></span>
									</p>
									<p>
										<span class="text-green-500">cv</span>
										<span class="text-zinc-600">:</span>
										<a
											class="text-zinc-100 underline decoration-green-700 underline-offset-2 hover:text-green-300"
											href="/isaias_isurieta_aldana_cv.pdf"
											target="_blank"
											download>Download_IsaiasIsurieta_cv.pdf</a
										>
									</p>
									<p>
										<span class="text-green-500">linkedin</span>
										<span class="text-zinc-600">:</span>
										<a
											class="text-zinc-100 underline decoration-green-700 underline-offset-2 hover:text-green-300"
											href="https://www.linkedin.com/in/isaías-isurieta-aldana"
											target="_blank"
											rel="noopener noreferrer">Link_IsaiasIsurieta</a
										>
									</p>
									<p>
										<span class="text-green-500">github</span>
										<span class="text-zinc-600">:</span>
										<a
											class="text-zinc-100 underline decoration-green-700 underline-offset-2 hover:text-green-300"
											href="https://github.com/isaiasisurieta"
											target="_blank"
											rel="noopener noreferrer">Link_IsaiasIsurieta</a
										>
									</p>
								</div>

								{/* Prompt Final Estático */}
								<div class="mt-3 hidden flex-wrap items-baseline gap-x-2" data-typed-prompt-final>
									<span class="text-green-400">isaías@portfolio</span>
									<span class="text-zinc-500">:</span>
									<span class="text-green-200">~</span>
									<span class="text-zinc-100">$</span>
									<span class="typed-cursor" aria-hidden="true" data-terminal-cursor="final"></span>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div
				class="laptop-hinge relative z-10 h-2.5 bg-linear-to-b from-[#2b323d] via-[#171c24] to-[#090c11] shadow-[0_6px_10px_-5px_rgba(0,0,0,0.95)]"
				aria-hidden="true"
			>
				<div
					class="absolute inset-x-8 top-1/2 h-px -translate-y-1/2 bg-black/70 shadow-[0_1px_0_rgba(255,255,255,0.04)]"
				>
				</div>
			</div>

			<div class="laptop-base origin-top rounded-b-[1.4rem] border border-t-0 border-black/75 bg-linear-to-b from-[#303845] via-[#1b212b] to-[#0e1218] px-3 pb-3 pt-2 shadow-[0_34px_48px_-24px_rgba(0,0,0,0.95),inset_0_1px_0_rgba(255,255,255,0.07)] sm:px-5 sm:pb-4">
				<div class="laptop-deck relative h-24 rounded-xl bg-linear-to-b from-[#252c37] via-[#1b212b] to-[#12171e] p-2 shadow-[inset_0_2px_4px_rgba(255,255,255,0.04),inset_0_-4px_8px_rgba(0,0,0,0.5),0_2px_4px_rgba(0,0,0,0.45)] sm:h-32 sm:p-2.5" aria-hidden="true">
					{
						keyRows.map((row) => (
							<div class="flex justify-center gap-1.5">
								{Array.from({ length: row.keys }).map(() => (
									<span
										class:list={[
											'h-2 rounded-[4px] border border-zinc-600/80 bg-linear-to-b from-zinc-700 to-zinc-800 shadow-[inset_0_1px_0_rgba(255,255,255,0.12),0_2px_2px_rgba(0,0,0,0.55)] sm:h-3',
											row.size === 'md' ? 'w-[7.2%]' : 'w-[6.2%]',
										]}
									/>
								))}
							</div>
						))
					}
					<div class="flex justify-center pt-0.5">
						<span
							class="h-2 w-[38%] rounded-[4px] border border-zinc-600/80 bg-linear-to-b from-zinc-700 to-zinc-800 shadow-[inset_0_1px_0_rgba(255,255,255,0.1),0_2px_2px_rgba(0,0,0,0.5)] sm:h-3"
						>
						</span>
					</div>
				</div>

				<div
					class="mx-auto mt-2 h-1.5 w-16 rounded-b-md bg-[#11151c] ring-1 ring-inset ring-white/10"
					aria-hidden="true"
				>
				</div>

				<div
					class="mx-auto mt-2 h-10 w-[32%] rounded-lg border border-black/60 bg-[#171c24] shadow-[inset_0_2px_4px_rgba(0,0,0,0.55),0_1px_0_rgba(255,255,255,0.04)] sm:h-12"
					aria-hidden="true"
				>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.laptop-scene {
		
	}

	.laptop {
		
	filter: drop-shadow(0 30px 24px rgb(0 0 0 / 0.32));
		
	}

	.laptop-lid {
		
	}

	.laptop-base {
		
		box-shadow: 0 28px 40px -24px rgb(0 0 0 / 0.85);
	}

	
		
		
	}

	
		
		box-shadow:
			0 0 0 1px rgb(0 0 0 / 0.55),
			0 -24px 60px -20px rgb(15 23 42 / 0.45);
	}

	.screen-video,
	.screen-terminal {
		transition: opacity 700ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.screen-reflection {
		background: linear-gradient(125deg, rgb(255 255 255 / 0.12), transparent 28%, transparent 68%, rgb(125 211 252 / 0.04));
		mix-blend-mode: screen;
	}

	.terminal-topbar {
		font-family: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
	}

	.screen-video.is-hidden {
		opacity: 0;
		pointer-events: none;
	}

	.screen-terminal {
		pointer-events: none;
		font-family: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
	}

	.screen-terminal.is-visible {
		opacity: 1;
		pointer-events: auto;
	}

	.screen-scanlines {
		opacity: 0.4;
		background: repeating-linear-gradient(
			to bottom,
			transparent 0,
			transparent 2px,
			rgb(0 0 0 / 0.2) 2px,
			rgb(0 0 0 / 0.2) 4px
		);
	}

	.typed-cursor {
		display: none;
		width: 0.55em;
		height: 1.1em;
		background-color: #61afef;
		box-shadow: 0 0 8px rgb(97 175 239 / 0.7);
		animation: blink 1.05s cubic-bezier(0.4, 0, 0.6, 1) infinite;
		margin-left: 3px;
		vertical-align: -0.18em;
	}

	.typed-cursor.is-active {
		display: inline-block;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.laptop,
		.laptop-lid,
		.screen-video,
		.screen-terminal {
			transition: none;
		}

		
			
		}

		
			
		}

		.typed-cursor {
			animation: none;
		}
	}
</style>

<script>
	const VIDEO_START_TIMEOUT_MS = 8000;
	const VIDEO_STALL_TIMEOUT_MS = 2000;
	const TYPE_MS = 72;
	const COMMAND1 = 'whoami';
	const COMMAND2 = 'cat contact.txt';

	const video = document.querySelector<HTMLVideoElement>('[data-intro-video]');
	const terminal = document.querySelector<HTMLElement>('[data-intro-terminal]');
	const command1El = document.querySelector<HTMLElement>('[data-typed-command1]');
	const profileEl = document.querySelector<HTMLElement>('[data-typed-profile]');
	const prompt2El = document.querySelector<HTMLElement>('[data-typed-prompt2]');
	const command2El = document.querySelector<HTMLElement>('[data-typed-command2]');
	const linksEl = document.querySelector<HTMLElement>('[data-typed-links]');
	const promptFinalEl = document.querySelector<HTMLElement>('[data-typed-prompt-final]');
	const cursor1 = document.querySelector<HTMLElement>('[data-terminal-cursor="1"]');
	const cursor2 = document.querySelector<HTMLElement>('[data-terminal-cursor="2"]');
	const finalCursor = document.querySelector<HTMLElement>('[data-terminal-cursor="final"]');
	const emailBtn = document.querySelector<HTMLButtonElement>('[data-copy-email]');
	const copyFeedback = document.querySelector<HTMLElement>('[data-copy-feedback]');

	if (video && terminal && command1El && profileEl && prompt2El && command2El && linksEl && promptFinalEl && cursor1 && cursor2 && finalCursor) {
		const introVideo = video;
		const introTerminal = terminal;
		const typedCommand1 = command1El;
		const typedProfile = profileEl;
		const typedPrompt2 = prompt2El;
		const typedCommand2 = command2El;
		const typedLinks = linksEl;
		const typedPromptFinal = promptFinalEl;
		const cursors = [cursor1, cursor2, finalCursor];
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let switched = false;
		let fallbackId: number | undefined;
		let observer: IntersectionObserver | undefined;

		const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

		function activateCursor(cursor: HTMLElement) {
			for (const currentCursor of cursors) currentCursor.classList.remove('is-active');
			cursor.classList.add('is-active');
		}

		function clearFallback() {
			if (fallbackId !== undefined) {
				window.clearTimeout(fallbackId);
				fallbackId = undefined;
			}
		}

		function scheduleFallback(delay: number) {
			clearFallback();
			fallbackId = window.setTimeout(showTerminal, delay);
		}

		async function typeInto(el: HTMLElement, text: string, speed: number) {
			for (const char of text) {
				el.textContent += char;
				if (speed > 0) await sleep(speed);
			}
		}

		async function runTerminal() {
			introTerminal.removeAttribute('aria-hidden');

			if (reduceMotion) {
				typedCommand1.textContent = COMMAND1;
				typedProfile.classList.remove('hidden');
				typedProfile.classList.add('flex');
				typedPrompt2.classList.remove('hidden');
				typedPrompt2.classList.add('flex');
				typedCommand2.textContent = COMMAND2;
				typedLinks.classList.remove('hidden');
				typedPromptFinal.classList.remove('hidden');
				activateCursor(finalCursor);
				return;
			}

			// Escribir comando 1: whoami
			activateCursor(cursor1);
			await typeInto(typedCommand1, COMMAND1, TYPE_MS);
			cursor1.classList.remove('is-active');
			await sleep(150);

			// Mostrar Info de Usuario
			typedProfile.classList.remove('hidden');
			typedProfile.classList.add('flex');
			await sleep(350);

			// Mostrar Prompt 2 y escribir comando 2: cat contact.txt
			typedPrompt2.classList.remove('hidden');
			typedPrompt2.classList.add('flex');
			activateCursor(cursor2);
			await typeInto(typedCommand2, COMMAND2, TYPE_MS);
			cursor2.classList.remove('is-active');
			await sleep(150);

			// Mostrar enlaces y prompt final
			typedLinks.classList.remove('hidden');
			typedPromptFinal.classList.remove('hidden');
			typedPromptFinal.classList.add('flex');
			activateCursor(finalCursor);
		}

		function showTerminal() {
			if (switched) return;
			switched = true;
			clearFallback();
			observer?.disconnect();

			introVideo.classList.add('is-hidden');
			introTerminal.classList.add('is-visible');
			introVideo.pause();

			const reveal = () => {
				void runTerminal();
			};

			if (reduceMotion) {
				reveal();
			} else {
				window.setTimeout(reveal, 350);
			}
		}

		function startVideo() {
			if (switched) return;

			const videoSrc = introVideo.dataset.videoSrc;
			if (!videoSrc) {
				showTerminal();
				return;
			}

			scheduleFallback(VIDEO_START_TIMEOUT_MS);
			introVideo.src = videoSrc;
			introVideo.load();
			void introVideo.play().catch(showTerminal);
		}

		introVideo.addEventListener('ended', showTerminal);
		introVideo.addEventListener('error', showTerminal);
		introVideo.addEventListener('playing', clearFallback);
		introVideo.addEventListener('waiting', () => scheduleFallback(VIDEO_STALL_TIMEOUT_MS));
		introVideo.addEventListener('stalled', () => scheduleFallback(VIDEO_STALL_TIMEOUT_MS));

		if (reduceMotion) {
			showTerminal();
		} else if ('IntersectionObserver' in window) {
			observer = new IntersectionObserver((entries) => {
				if (entries.some((entry) => entry.isIntersecting)) {
					startVideo();
				}
			}, { rootMargin: '200px' });

			const scene = document.querySelector<HTMLElement>('.laptop-scene');
			if (scene) {
				observer.observe(scene);
			} else {
				startVideo();
			}
		} else {
			startVideo();
		}
	}

	if (emailBtn && copyFeedback) {
		emailBtn.addEventListener('click', async () => {
			const email = emailBtn.dataset.copyEmail;
			if (!email) {
				copyFeedback.textContent = 'No se encontró la dirección de correo.';
				return;
			}

			if (!navigator.clipboard?.writeText) {
				copyFeedback.textContent = 'Copia manualmente la dirección de correo.';
				return;
			}

			try {
				await navigator.clipboard.writeText(email);
				copyFeedback.textContent = 'Correo copiado.';
			} catch {
				copyFeedback.textContent = 'No se pudo copiar. Selecciona el correo y cópialo manualmente.';
			}
		});
	}
</script>