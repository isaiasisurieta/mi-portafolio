---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Footer from '../components/Footer.astro';

const projects = [
	{
		title: 'Proyecto uno',
		description: 'Descripción breve de lo que hace este proyecto y el problema que resuelve.',
		tags: ['Astro', 'Tailwind'],
		href: '#',
	},
	{
		title: 'Proyecto dos',
		description: 'Otra tarjeta de ejemplo. Sustituye estos datos por tus proyectos reales.',
		tags: ['TypeScript', 'UI'],
		href: '#',
	},
	{
		title: 'Proyecto tres',
		description: 'Mantén esta página limpia: los detalles viven en cada componente.',
		tags: ['Frontend'],
		href: '#',
	},
];
---

<Layout>
	<Header />
	<main>
		<Hero />
		<section id="proyectos" class="mx-auto max-w-5xl px-6 pb-24">
			<h2 class="mb-8 text-2xl font-semibold tracking-tight text-zinc-50">
				Proyectos
			</h2>
			<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{projects.map((project) => <ProjectCard {...project} />)}
			</div>
		</section>
	</main>
	<Footer />
</Layout>
